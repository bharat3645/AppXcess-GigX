# RPC endpoint used by Hardhat to reach the Sepolia testnet (Alchemy or Infura).
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the wallet used to deploy contracts. NEVER commit a real key.
# Use a throwaway/testnet-only wallet funded with Sepolia test ETH.
PRIVATE_KEY=your_testnet_wallet_private_key

# Optional: Etherscan API key, used by @nomicfoundation/hardhat-verify to verify
# deployed contract source code.
ETHERSCAN_API_KEY=your_etherscan_api_key
