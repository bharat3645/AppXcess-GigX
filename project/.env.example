# Address of the deployed Job contract (copy the "job" address from
# ../deployed-addresses.json after running the deploy script).
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourDeployedJobContractAddress

# Sepolia RPC endpoint used by the frontend to read on-chain job data.
NEXT_PUBLIC_PROVIDER_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
